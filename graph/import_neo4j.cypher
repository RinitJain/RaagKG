  {id: "raga:puriya-dhanashree", name: "Puriya Dhanashree", aroha: "N r G M' P D N S'", avaroha: "S' N D P M' G r S", pakad: "N r G, M' P, D P, M' G M' r S", prahar_text: "Late Afternoon / Sunset (4PM-6PM)"},
