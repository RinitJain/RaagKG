CREATE CONSTRAINT jaati_id IF NOT EXISTS FOR (n:Jaati) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT prahar_id IF NOT EXISTS FOR (n:Prahar) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT prakriti_id IF NOT EXISTS FOR (n:Prakriti) REQUIRE n.id IS UNIQUE;
