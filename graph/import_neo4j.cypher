  {id: "raga:nayaki-kanada", name: "Nayaki Kanada", aroha: "S R g m P n S'", avaroha: "S' n P m P g R S", pakad: "R P, g m R S", prahar_text: "Mid Night (9PM-12AM)"},
  {id: "raga:pahadi", name: "Pahadi", aroha: "S R G P D S' (varies)", avaroha: "S' D P G R S (varies)", pakad: "P D S' R' G', R' S' D P", prahar_text: "Any time (Sarvakalik)"},
  {id: "raga:palasi", name: "Palasi", aroha: "n S g m P n S'", avaroha: "S' n d P m g R S", pakad: "d P m g, R g m P", prahar_text: "Late Afternoon (3-6pm)"},
  {id: "raga:paraj", name: "Paraj", aroha: "N S G M' P D N S'", avaroha: "S' N d P, M' P d G, M' G r S", pakad: "N S G M' P", prahar_text: "Last Quarter of Night (3AM-6AM)"},
  {id: "raga:patdeep", name: "Patdeep", aroha: "N S g m P N S'", avaroha: "S' N D P m g R S", pakad: "N S g m P, D P, m g R S", prahar_text: "Late Afternoon (3PM-6PM)"},
  {id: "raga:pilu", name: "Pilu", aroha: "S G m P N S'", avaroha: "S' n D P m G R S", pakad: "N S G m P", prahar_text: "Late Afternoon (3PM-6PM)"},
  {id: "raga:poorvi", name: "Poorvi", aroha: "N r G M' d N S'", avaroha: "S' N d P M' G r S", pakad: "N r G, M' d P, M' G r S", prahar_text: "Sunset (6PM-9PM)"},
