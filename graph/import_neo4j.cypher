CREATE CONSTRAINT swar_id IF NOT EXISTS FOR (n:Swar) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT thaat_id IF NOT EXISTS FOR (n:Thaat) REQUIRE n.id IS UNIQUE;

